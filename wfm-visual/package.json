{
  "name": "verint-wfm-visual",
  "version": "1.3.0",
  "description": "Verint-inspired Workforce Management visual: intraday, daily and weekly forecast vs actual.",
  "private": true,
  "scripts": {
    "start": "pbiviz start",
    "package": "pbiviz package",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "scan": "node scripts/scan.mjs",
    "verify": "tsc --noEmit && eslint src && node scripts/scan.mjs && npm audit",
    "package:certified": "node scripts/edition.mjs certified",
    "package:writeback": "node scripts/edition.mjs writeback"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "powerbi-visuals-api": "~5.11.0",
    "powerbi-visuals-utils-formattingmodel": "6.0.1"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-powerbi-visuals": "^1.1.1",
    "powerbi-visuals-tools": "^7.2.1",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "powerbi-visuals-api": "$powerbi-visuals-api",
    "uuid": "^11.1.1",
    "minimatch": "^11.0.4"
  }
}