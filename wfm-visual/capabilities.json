{
  "privileges": [],
  "supportsLandingPage": true,
  "supportsEmptyDataView": true,
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    }
  },
  "dataRoles": [
    {
      "name": "interval",
      "displayName": "Interval (date/time)",
      "kind": "Grouping",
      "description": "Start timestamp of each 15/30/60-minute interval",
      "displayNameKey": "Role_interval"
    },
    {
      "name": "skill",
      "displayName": "Skill / Queue",
      "kind": "Grouping",
      "description": "Skill or queue. Enables skill-based planning",
      "displayNameKey": "Role_skill"
    },
    {
      "name": "team",
      "displayName": "Team",
      "kind": "Grouping",
      "description": "Optional. Enables SLA per team",
      "displayNameKey": "Role_team"
    },
    {
      "name": "level",
      "displayName": "Level / Tier",
      "kind": "Grouping",
      "description": "Optional. Agent level (L1/L2/L3, Junior/Senior\u2026)",
      "displayNameKey": "Role_level"
    },
    {
      "name": "agent",
      "displayName": "Agent / Team",
      "kind": "Grouping",
      "description": "Optional. Enables the roster panel",
      "displayNameKey": "Role_agent"
    },
    {
      "name": "avatarUrl",
      "displayName": "Avatar image URL",
      "kind": "Grouping",
      "description": "Optional. https or data: image URL for each agent/team",
      "displayNameKey": "Role_avatarUrl"
    },
    {
      "name": "forecastVolume",
      "displayName": "Forecast volume",
      "kind": "Measure",
      "displayNameKey": "Role_forecastVolume"
    },
    {
      "name": "actualVolume",
      "displayName": "Actual volume",
      "kind": "Measure",
      "displayNameKey": "Role_actualVolume"
    },
    {
      "name": "forecastAht",
      "displayName": "Forecast AHT (sec)",
      "kind": "Measure",
      "displayNameKey": "Role_forecastAht"
    },
    {
      "name": "actualAht",
      "displayName": "Actual AHT (sec)",
      "kind": "Measure",
      "displayNameKey": "Role_actualAht"
    },
    {
      "name": "requiredFte",
      "displayName": "Required FTE",
      "kind": "Measure",
      "displayNameKey": "Role_requiredFte"
    },
    {
      "name": "scheduledFte",
      "displayName": "Scheduled FTE",
      "kind": "Measure",
      "displayNameKey": "Role_scheduledFte"
    },
    {
      "name": "serviceLevel",
      "displayName": "Service level (0-1)",
      "kind": "Measure",
      "displayNameKey": "Role_serviceLevel"
    },
    {
      "name": "adherence",
      "displayName": "Adherence (0-1)",
      "kind": "Measure",
      "displayNameKey": "Role_adherence"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "interval": {
            "min": 1,
            "max": 1
          }
        }
      ],
      "table": {
        "rows": {
          "select": [
            {
              "for": {
                "in": "interval"
              }
            },
            {
              "for": {
                "in": "skill"
              }
            },
            {
              "for": {
                "in": "team"
              }
            },
            {
              "for": {
                "in": "level"
              }
            },
            {
              "for": {
                "in": "agent"
              }
            },
            {
              "for": {
                "in": "avatarUrl"
              }
            },
            {
              "for": {
                "in": "forecastVolume"
              }
            },
            {
              "for": {
                "in": "actualVolume"
              }
            },
            {
              "for": {
                "in": "forecastAht"
              }
            },
            {
              "for": {
                "in": "actualAht"
              }
            },
            {
              "for": {
                "in": "requiredFte"
              }
            },
            {
              "for": {
                "in": "scheduledFte"
              }
            },
            {
              "for": {
                "in": "serviceLevel"
              }
            },
            {
              "for": {
                "in": "adherence"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 30000
            }
          }
        }
      }
    }
  ],
